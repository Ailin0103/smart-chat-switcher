{
  "manifest_version": 3,
  "name": "Smart Chat Switcher",
  "version": "0.2.2",
  "description": "Route ChatGPT drafts to your saved contexts, with local matching and reversible handoffs.",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "options_page": "settings.html",
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["core.js", "content.js"], "run_at": "document_start"}]
}
